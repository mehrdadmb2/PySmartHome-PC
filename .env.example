# Copy this file to .env for local environment configuration.
# Do not commit the local .env file.

# Local Flask server (keep loopback unless LAN clients need access)
PYSMART_HOME_HOST=127.0.0.1
PYSMART_HOME_PORT=5000
# Set host to 0.0.0.0 only when ESP32 boards must access the PC over your LAN.
# Keep Windows Firewall restricted to your trusted Private network.
# PYSMART_HOME_HOST=0.0.0.0
PYSMART_HOME_POLL_SECONDS=10
PYSMART_HOME_PUBLISH_SECONDS=300
PYSMART_HOME_NODE_TIMEOUT=45
PYSMART_HOME_HTTP_TIMEOUT=4
PYSMART_TEMP_ALERT=35.0
PYSMART_HOME_ADMIN_KEY=
PYSMART_LOG_LEVEL=INFO

# ESP32 node endpoints (change only if the static IPs are changed)
PYSMART_ESP32_1_URL=http://192.168.1.119/api/status
PYSMART_ESP32_S3_URL=http://192.168.1.115/api/status

# Optional GitHub Contents API sync for the dashboard's sensor data.
# This token is not used by the market Action; Actions uses its built-in GITHUB_TOKEN.
PYSMART_GITHUB_USER=mehrdadmb2
PYSMART_GITHUB_REPO=PySmartHome-PC
PYSMART_GITHUB_BRANCH=main
PYSMART_GITHUB_TOKEN=

# GitHub Actions market snapshot proxy (PC fetches the small JSON; ESP32 reads local HTTP).
PYSMART_MARKET_SOURCE_URL=https://raw.githubusercontent.com/mehrdadmb2/PySmartHome-PC/main/market/esp32.json
PYSMART_MARKET_REFRESH_SECONDS=60
PYSMART_MARKET_HTTP_TIMEOUT=5
